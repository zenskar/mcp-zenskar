{
  "name": "mcp-zenskar",
  "version": "2.2.5",
  "description": "Model Context Protocol (MCP) server for Zenskar API - customer management, invoicing, and billing operations",
  "type": "module",
  "main": "dist/server.mjs",
  "bin": {
    "mcp-zenskar": "dist/server.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/server.mjs",
    "predev:ui": "node scripts/gen-shape-html.js",
    "dev:ui": "vite --config vite.config.ts",
    "prebuild:ui": "node scripts/gen-shape-html.js",
    "build:ui": "node src/ui/server/build.js",
    "prebuild": "pnpm run build:ui",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test:mcp-schema": "node --test src/test/mcp-list-tools.test.js",
    "test:tool-schema": "node --test src/test/tool-schema.test.js",
    "smoke": "tsx src/ui/test/smoke.ts",
    "test": "pnpm run test:tool-schema && pnpm run test:mcp-schema && pnpm run smoke"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zenskar",
    "billing",
    "invoicing",
    "customer-management",
    "ai-tool",
    "claude",
    "llm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.2.4",
    "@toon-format/toon": "^2.2.0",
    "@types/node": "^25.6.0",
    "preact": "^10.29.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "vite": "^8.0.10",
    "vite-plugin-singlefile": "^2.3.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@11.1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenskar/mcp-zenskar"
  },
  "bugs": {
    "url": "https://github.com/zenskar/mcp-zenskar/issues"
  },
  "homepage": "https://github.com/zenskar/mcp-zenskar#readme"
}
